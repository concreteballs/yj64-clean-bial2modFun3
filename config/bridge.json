{
  "agent_id": "yj64-internal-diagnostic-agent",
  "target_package": "org.blackmirror.blackmirror",
  "bridge": {
    "authority": "org.blackmirror.yj64monitor.diagnostics",
    "method": "receive_report",
    "connect_timeout_seconds": 1.0,
    "retry_count": 3,
    "retry_delay_seconds": 0.5
  },
  "report": {
    "spool_filename": "yj64-reports/yj64-report.jsonl",
    "https_endpoint": ""
  }
}
