    def export_private_archives(self)->list[Path]:
        """Write one isolated private ZIP per participant into app-private storage."""
        source_dir=self.workspace_path/"histories"
        if not source_dir.is_dir() or source_dir.is_symlink():
            return []
        target_dir=self.root/"yj64-private-archives"
        target_dir.mkdir(parents=True,exist_ok=True)
        created=[]
        for source in sorted(source_dir.glob("*.json")):
            if not source.is_file() or source.is_symlink():
                continue
            participant_id=source.stem
            if not participant_id or not re.fullmatch(r"[A-Za-z0-9_-]+",participant_id):
                continue
            payload=source.read_bytes()
            try:
                rows=json.loads(payload.decode("utf-8"))
            except (UnicodeDecodeError,json.JSONDecodeError) as exc:
                raise IOError("Invalid private history: "+source.name) from exc
            if not isinstance(rows,list):
                raise IOError("Private history must be a JSON list: "+source.name)
            member="histories/"+source.name
            now=int(time.time()*1000)
            manifest={
                "schema":"yj64.private-chat.v1",
                "participant_id":participant_id,
                "created_at":time.strftime("%Y-%m-%dT%H:%M:%SZ",time.gmtime(now/1000)),
                "files":{member:{"sha256":self._sha(payload),"size":len(payload)}},
            }
            destination=target_dir/("YJ-64-PRIVATE-"+participant_id+".zip")
            temporary=destination.with_suffix(".zip.tmp")
            try:
                with zipfile.ZipFile(temporary,"w",compression=zipfile.ZIP_DEFLATED) as archive:
                    archive.writestr(member,payload)
                    archive.writestr("manifest.json",json.dumps(manifest,ensure_ascii=False,indent=2))
                with zipfile.ZipFile(temporary,"r") as check:
                    if check.testzip() or set(check.namelist())!={member,"manifest.json"}:
                        raise IOError("Private archive integrity check failed: "+participant_id)
                    if self._sha(check.read(member))!=manifest["files"][member]["sha256"]:
                        raise IOError("Private archive SHA-256 mismatch: "+participant_id)
                os.replace(temporary,destination)
            except Exception:
                temporary.unlink(missing_ok=True)
                raise
            created.append(destination)
        return created

